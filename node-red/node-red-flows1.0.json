    {
        "id": "a908d2180de35828",
        "type": "function",
        "z": "1934d6b760a697cb",
        "name": "FFT Buffer (N=32, 5Hz)",
        "func": "const N = 32;\nlet buf = context.get('buf') || { pitch: [], roll: [], yaw: [] };\n\nbuf.pitch.push(msg.pitchDeg);\nbuf.roll.push(msg.rollDeg);\nbuf.yaw.push(msg.yawDeg);\n\nif(buf.pitch.length > N) buf.pitch.shift();\nif(buf.roll.length  > N) buf.roll.shift();\nif(buf.yaw.length   > N) buf.yaw.shift();\n\ncontext.set('buf', buf);\n\nif(buf.pitch.length < N) return null;\n\nfunction dft(x) {\n    const n = x.length;\n    let mag = [];\n    for(let k = 0; k < n/2; k++) {\n        let re = 0, im = 0;\n        for(let t = 0; t < n; t++) {\n            re += x[t] * Math.cos(2*Math.PI*k*t/n);\n            im -= x[t] * Math.sin(2*Math.PI*k*t/n);\n        }\n        mag.push(Math.sqrt(re*re + im*im) / n);\n    }\n    return mag;\n}\n\nconst fs = 5;\nconst freqs = Array.from({length: N/2}, function(_,i){ return parseFloat((i*fs/N).toFixed(2)); });\n\nmsg.payload = {\n    freqs: freqs,\n    magPitch: dft(buf.pitch),\n    magRoll:  dft(buf.roll),\n    magYaw:   dft(buf.yaw)\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
