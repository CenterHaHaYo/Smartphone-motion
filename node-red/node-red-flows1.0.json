    {
        "id": "fft_template_all",
        "type": "ui_template",
        "z": "1934d6b760a697cb",
        "group": "b827c8afa4cce7a1",
        "name": "FFT Charts",
        "order": 1,
        "width": "12",
        "height": "14",
        "format": "<div style=\"background:#fff;padding:10px;\">\n  <canvas id=\"fftPitchCanvas\" height=\"120\"></canvas>\n  <canvas id=\"fftRollCanvas\" height=\"120\"></canvas>\n  <canvas id=\"fftYawCanvas\" height=\"120\"></canvas>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js\"></script>\n<script>\n(function(scope){\n  var charts = {};\n\n  function makeChart(canvasId, label, color){\n    var ctx = document.getElementById(canvasId);\n    if(!ctx) return null;\n    return new Chart(ctx, {\n      type:'bar',\n      data:{ labels:[], datasets:[{ label:label, data:[], backgroundColor:color, borderWidth:0 }] },\n      options:{\n        responsive:true,\n        animation:false,\n        scales:{\n          x:{ title:{ display:true, text:'Frequency (Hz)' }},\n          y:{ title:{ display:true, text:'Magnitude' }, beginAtZero:true }\n        },\n        plugins:{ legend:{ display:true }}\n      }\n    });\n  }\n\n  setTimeout(function(){\n    charts.pitch = makeChart('fftPitchCanvas','FFT Pitch','rgba(26,115,232,0.7)');\n    charts.roll  = makeChart('fftRollCanvas','FFT Roll','rgba(229,57,53,0.7)');\n    charts.yaw   = makeChart('fftYawCanvas','FFT Yaw','rgba(67,160,71,0.7)');\n  }, 500);\n\n  scope.$watch('msg', function(msg){\n    if(!msg || !msg.payload || !msg.payload.freqs) return;\n    var d = msg.payload;\n    var labels = d.freqs.map(function(f){ return f.toFixed(2); });\n\n    if(charts.pitch){\n      charts.pitch.data.labels = labels;\n      charts.pitch.data.datasets[0].data = d.magPitch;\n      charts.pitch.update();\n    }\n    if(charts.roll){\n      charts.roll.data.labels = labels;\n      charts.roll.data.datasets[0].data = d.magRoll;\n      charts.roll.update();\n    }\n    if(charts.yaw){\n      charts.yaw.data.labels = labels;\n      charts.yaw.data.datasets[0].data = d.magYaw;\n      charts.yaw.update();\n    }\n  });\n})(scope);\n</script>",
