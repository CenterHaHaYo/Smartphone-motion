        "id": "337b29a9fd722040",
        "type": "http request",
        "z": "1934d6b760a697cb",
        "name": "GET pitch roll yaw",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://192.168.1.35:8080/get?pitch&roll&yaw",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 380,
