                "db1820c2d8a2bb16"
            ]
        ]
    },
    {
        "id": "db1820c2d8a2bb16",
        "type": "function",
        "z": "1934d6b760a697cb",
        "name": "Extract + radians + axis/up",
        "func": "try {\n    let data = msg.payload;\n\n    let pitchDeg = data.buffer.pitch.buffer[0];\n    let rollDeg  = data.buffer.roll.buffer[0];\n    let yawDeg   = data.buffer.yaw.buffer[0];\n\n    let pitch = pitchDeg * Math.PI / 180;\n    let roll  = rollDeg  * Math.PI / 180;\n    let yaw   = yawDeg   * Math.PI / 180;\n\n    let axis_x = Math.cos(yaw) * Math.cos(pitch);\n    let axis_y = Math.sin(pitch);\n    let axis_z = Math.sin(yaw) * Math.cos(pitch);\n\n    let up_x = -Math.sin(roll);\n    let up_y =  Math.cos(roll);\n    let up_z = 0;\n\n    msg.pitchDeg = pitchDeg;\n    msg.rollDeg  = rollDeg;\n    msg.yawDeg   = yawDeg;\n    msg.pitch    = pitch;\n    msg.roll     = roll;\n    msg.yaw      = yaw;\n    msg.axis_x   = axis_x;\n    msg.axis_y   = axis_y;\n    msg.axis_z   = axis_z;\n    msg.up_x     = up_x;\n    msg.up_y     = up_y;\n    msg.up_z     = up_z;\n\n    msg.payload = {\n        pitchDeg: pitchDeg, rollDeg: rollDeg, yawDeg: yawDeg,\n        pitch: pitch, roll: roll, yaw: yaw,\n        axis_x: axis_x, axis_y: axis_y, axis_z: axis_z,\n        up_x: up_x, up_y: up_y, up_z: up_z\n    };\n\n    return msg;\n} catch(err) {\n    return null;\n}",
        "outputs": 1,
        "noerr": 0,
        "x": 320,
        "y": 200,
        "wires": [
            [
                "2bd89d825a6d1d42",
                "792777de4f64de04",
                "ff7aac48c042afdc",
                "e91ff222ca3b1b90",
                "0dab2298fea2fc1e",
                "bf9ceaf143cd8b3b",
                "c3b37701cd074cb3",
                "d96f8cd159cf27c0",
                "afe036035c7a7f74",
                "dd5c36dcaf7f204b",
                "cfb077e3199b5087",
                "f34b2bf2184366cc",
                "521c10bd9c9932e7",
                "a908d2180de35828"
            ]
        ]
    },
