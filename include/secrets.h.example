#pragma once

// Copy this file to secrets.h (in the same folder) and fill in your own values.
// secrets.h is gitignored and never committed.

#define WIFI_SSID     "your-home-wifi-ssid"
#define WIFI_PASSWORD "your-home-wifi-password"

// Credentials the ESP32-S3 uses when it broadcasts its OWN Wi-Fi (Access Point mode).
// Password must be at least 8 characters for WPA2.
#define AP_SSID       "ESP32-S3"
#define AP_PASSWORD   "your-ap-password"
